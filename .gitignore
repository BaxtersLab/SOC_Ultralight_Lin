# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Desktop-layout screenshots — full 1920x1080 captures of the operator's real
# screen. Readable chat text, a file listing, the taskbar and the account name
# were all visible. The README documents the layout as a diagram instead.
# Do not re-add a screenshot here; describe or crop tightly instead.
docs/images/desktop_layout_*.PNG
docs/images/desktop_layout_*.png

# SOC runtime artifacts (generated at run time, machine-specific)
config.json
.soc_alive
soc_control.signal
data_log/
outbox/
sent/
staging/
transcript/


# ── Operator-private templates and policy — NEVER COMMIT ─────────────────────
# This remote is public and the rest of "buttons database" IS tracked, so a
# crop dropped in there is published by default. Some crops show things that
# must not be: an account name, a device identifier, the contents of a window.
#
# Anything under buttons database/private/ is scanned by SOC exactly like the
# main library but never enters version control. A whole directory rather than
# a name pattern, so nothing depends on remembering to name a file correctly.
buttons database/private/

# Operator policy (guard manifest and verifier modules) lives in
# $XDG_CONFIG_HOME/soc-ultralight/guards/ — outside this repo entirely, so it
# cannot be committed even by accident. These rules catch stray local copies.
guards/
manifest.json
